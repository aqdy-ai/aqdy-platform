# Aqdy Platform - Environment Variables Template
# ── Quick start ──────────────────────────────────────────────────
#   cp .env.example .env   # development: fill in real values
#   doppler setup           # production: fetch from Doppler dashboard
#
# ── Production: Use Doppler instead of .env ─────────────────────
# 1. Sign up at https://doppler.com
# 2. Create a project "backend" with configs: dev, stg, prd
# 3. Copy all secrets from .env.example into Doppler's dashboard
# 4. Run: doppler setup    (links your local repo to the project)
# 5. Generate a service token (Project → Access → Service Tokens)
# 6. Set DOPPLER_TOKEN=dp.st.xxx and NODE_ENV=production in your
#    production environment (or pass via docker-compose)
# 7. Optionally override DOPPLER_PROJECT (default: backend) and
#    DOPPLER_CONFIG (default: prd) if you use different names
#
# Do NOT commit your .env file with real secrets to version control

# ═══════════════════════════════════════════════════════════════
# BACKEND ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════

# Server Configuration
PORT=3000
NODE_ENV=development

# Doppler Secrets Manager (optional — fallback to .env when unset)
# DOPPLER_TOKEN=dp.st.dev.your_service_token_here
# DOPPLER_PROJECT=backend
# DOPPLER_CONFIG=prd

# Database Configuration
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/aqdy_platform

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_pinecone_index_name

# Langfuse Configuration (LLM Observability)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here

# SMTP Configuration (Email Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=noreply@aqdy.com

# Redis Configuration (Queue, Rate Limiting, Caching)
REDIS_URL=redis://localhost:6379

# Clause Analysis Concurrency (max parallel LLM calls per contract)
CLAUSE_ANALYSIS_CONCURRENCY=5

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ═══════════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT VARIABLES (Optional)
# ═══════════════════════════════════════════════════════════════

# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
